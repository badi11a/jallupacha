          }
        },
        "security": [
          {
            "jallupacha_session": []
          }
        ],
        "summary": "Consulta todos los campos de la ficha y el responsable vigente.",
        "tags": [
          "processes"
        ]
      },
      "patch": {
        "description": "Requiere perfil ADMIN o PROCESS_OWNER y ser responsable actual, salvo ADMIN.",
