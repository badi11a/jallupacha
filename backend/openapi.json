    "/processes": {
      "get": {
        "description": "Requiere sesión; pueden consultar ADMIN, PROCESS_OWNER, RISK_MANAGER y CONSULTATION.",
        "operationId": "ProcessController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessPageResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Sesión requerida."
          }
        },
        "security": [
          {
            "jallupacha_session": []
          }
        ],
        "summary": "Lista procesos activos por página, sin filtros avanzados.",
        "tags": [
          "processes"
        ]
      },
      "post": {
        "description": "Requiere perfil ADMIN o PROCESS_OWNER.",
        "operationId": "ProcessController_create",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProcessDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida o referencia no válida."
          },
          "403": {
            "description": "Se requiere perfil Dueño de proceso o Administrador."
          }
        },
        "security": [
          {
            "jallupacha_session": []
          }
        ],
        "summary": "Crea un Borrador y asigna el responsable desde la sesión autenticada.",
        "tags": [
          "processes"
        ]
      }
    },
    "/processes/{id}": {
      "get": {
        "description": "Requiere sesión; pueden consultar ADMIN, PROCESS_OWNER, RISK_MANAGER y CONSULTATION.",
