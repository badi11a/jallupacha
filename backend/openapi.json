  "info": {
    "title": "Jallupacha API",
    "description": "API institucional de gestión de procesos. Requiere sesión y perfiles autorizados, salvo endpoints de autenticación pública documentados explícitamente.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jallupacha_session"
      }
    },
    "schemas": {
      "DemoSessionDto": {
        "type": "object",
        "properties": {
          "identityId": {
            "type": "number",
            "minimum": 1,
            "description": "ID of a pre-seeded fictional demo identity"
          }
        },
        "required": [
          "identityId"
        ]
      },
      "UpdateProfilesDto": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "PROCESS_OWNER",
                "RISK_MANAGER",
                "CONSULTATION"
              ]
            }
          }
        },
        "required": [
          "profiles"
        ]
      },
      "CreateMacroprocessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "maxLength": 1000,
            "nullable": true
          },
          "order": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999
          }
        },
        "required": [
          "name",
          "order"
        ]
      },
      "UpdateMacroprocessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "maxLength": 1000,
            "nullable": true
          },
          "order": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999
          }
        }
      },
      "ProcessTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProcessTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "ProcessListItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "PR1"
          },
          "macroprocessId": {
            "type": "number"
          },
          "macroprocessName": {
            "type": "string"
          },
          "processTypeId": {
            "type": "number"
          },
          "processTypeName": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "number"
          },
          "ownerDisplayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Borrador"
            ]
          },
          "revision": {
            "type": "number",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "example": "Sin nombre"
          }
        },
        "required": [
          "id",
          "code",
          "macroprocessId",
          "macroprocessName",
          "processTypeId",
          "processTypeName",
          "ownerUserId",
          "ownerDisplayName",
          "status",
          "revision",
          "name"
        ]
      },
      "ProcessPageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProcessListItemResponseDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number",
            "maximum": 100
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "CreateProcessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "alias": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "objective": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "scope": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "inputs": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "outputs": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "suppliers": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "clients": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "involvedParties": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "startsWhen": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "endsWhen": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "developmentPlan": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "operation": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "design": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "validation": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "businessArea": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "subprocessType": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "criticality": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "automationLevel": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "periodicity": {
            "type": "string",
            "maxLength": 250,
            "nullable": true
          },
          "macroprocessId": {
            "type": "number",
            "minimum": 1
          },
          "processTypeId": {
            "type": "number",
            "minimum": 1
          },
          "parentProcessId": {
            "type": "number",
            "minimum": 1,
            "nullable": true
          }
        },
        "required": [
          "macroprocessId",
          "processTypeId"
        ]
      },
      "ProcessResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "PR1"
          },
          "macroprocessId": {
            "type": "number"
          },
          "macroprocessName": {
            "type": "string"
          },
          "processTypeId": {
            "type": "number"
          },
          "processTypeName": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "number"
