  "info": {
    "title": "Jallupacha API",
    "description": "API interna para el incremento 1. Requiere sesión y perfiles autorizados, salvo endpoints de demo local explícitos.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "jallupacha_session"
      }
    },
    "schemas": {
      "DemoSessionDto": {
        "type": "object",
        "properties": {
          "identityId": {
            "type": "number",
            "minimum": 1,
            "description": "ID of a pre-seeded fictional demo identity"
          }
        },
        "required": [
          "identityId"
        ]
      },
      "UpdateProfilesDto": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "PROCESS_OWNER",
                "RISK_MANAGER",
                "CONSULTATION"
              ]
            }
          }
        },
        "required": [
          "profiles"
        ]
      },
      "CreateMacroprocessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "maxLength": 1000,
            "nullable": true
          },
          "order": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999
          }
        },
        "required": [
          "name",
          "order"
        ]
      },
      "UpdateMacroprocessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "maxLength": 1000,
            "nullable": true
          },
          "order": {
            "type": "number",
            "minimum": 0,
            "maximum": 999999
          }
        }
      },
      "ProcessTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProcessTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    }
  }
