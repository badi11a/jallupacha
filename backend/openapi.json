              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida o referencia no válida."
          },
          "401": {
            "description": "Sesión requerida."
          },
          "403": {
            "description": "Proceso ajeno o perfil sin permiso."
          },
          "404": {
            "description": "Proceso inexistente."
          }
        },
        "security": [
          {
            "jallupacha_session": []
          }
        ],
        "summary": "Edita la ficha de un Borrador con revisión optimista.",
        "tags": [
          "processes"
        ]
      }
    },
    "/processes/{id}/owner": {
      "patch": {
