{
  "name": "@jallupacha/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.x",
    "npm": "11.12.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:grant": "ts-node src/database/grants.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:reset:local": "ts-node src/database/reset-local.ts",
    "docs:openapi": "ts-node src/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "oracledb": "6.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/cookie": "0.6.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  }
}
