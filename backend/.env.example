# Copy to backend/.env. Use separate Oracle users for runtime and migrations.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
AUTH_MODE=demo
DEMO_DATA_ENABLED=true
DEMO_UI_ORIGIN=http://127.0.0.1:4200
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=freepdb1
ORACLE_SCHEMA=JALLUPACHA_OWNER
DATABASE_USER=JALLUPACHA_APP
DATABASE_PASSWORD=
MIGRATION_USER=JALLUPACHA_OWNER
MIGRATION_PASSWORD=
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
