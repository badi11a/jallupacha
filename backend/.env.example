# Plantilla sin secretos. Copiar a backend/.env (local) o definir las mismas
# variables en el servidor (desarrollo/producción). Nunca versionar valores reales.
# Las variables del proceso tienen prioridad sobre backend/.env.
# El backend valida estas variables al iniciar y no arranca si faltan o son inválidas.

# Ambiente: local | development | production
APP_ENV=local
# development para local; production para desarrollo compartido y producción.
NODE_ENV=development
# Local: loopback. Servidores: interfaz acordada con el administrador.
HOST=127.0.0.1
PORT=3000
# demo solo con APP_ENV=local y HOST loopback; en servidores usar google.
AUTH_MODE=demo
DEMO_DATA_ENABLED=true
DEMO_UI_ORIGIN=http://127.0.0.1:4200

# Conexión Oracle (obligatorias).
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
# Opcional. En Windows, habilita modo Thick para bases Oracle heredadas.
# Ejemplo: C:\\oracle\\instantclient_23_5 o C:\\app\\usuario\\product\\dbhome\\bin
ORACLE_CLIENT_LIB_DIR=
# Opcional. Directorio con sqlnet.ora, para no alterar el Oracle Net global.
ORACLE_NET_CONFIG_DIR=
ORACLE_SCHEMA=JALLUPACHA_OWNER
# Usuario de ejecución con mínimos privilegios.
DATABASE_USER=JALLUPACHA_APP
DATABASE_PASSWORD=
# Usuario propietario, solo para migraciones y grants.
MIGRATION_USER=JALLUPACHA_OWNER
MIGRATION_PASSWORD=

# Reinicio destructivo; definir solo para un reinicio local intencional.
LOCAL_RESET_SCHEMA=
LOCAL_RESET_CONFIRM=

# Instalación destructiva de la base histórica; no acredita una instalación v15 completa.
# Elimina solo objetos conocidos de este producto en ORACLE_SCHEMA.
# Confirmación exacta: INSTALL SCHEMA <ORACLE_SCHEMA>@<ORACLE_SERVICE>.
SCHEMA_INSTALL_ALLOWED=false
SCHEMA_INSTALL_CONFIRM=
# Excepción explícita solo para QA cuando no existe una cuenta runtime separada.
# Nunca habilitar en producción.
SCHEMA_ALLOW_OWNER_RUNTIME_FOR_QA=false

API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
